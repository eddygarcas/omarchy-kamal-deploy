#!/usr/bin/env ruby
# Provision a virtual private server for Kamal deployments (Ubuntu, idempotent
# — safe to re-run on an already-provisioned server).
#
# It relies on SSH key authentication.
# Make sure to add your private key first:
#   ssh-add ~/path/to/ssh/key
#
# Usage:
#   ruby provision                 → reads config/deploy.yml
#   ruby provision production      → reads config/deploy.production.yml
#   ruby provision staging         → reads config/deploy.staging.yml
#   ruby provision sandbox         → reads config/deploy.sandbox.yml
#
# Generated by the Kamal Deploy Omarchy plugin's Provision Wizard on
# <%= generated_at %>. Safe to hand-edit afterwards — running the wizard
# again for this folder will overwrite this file.
#
require "net/ssh"
require "kamal"

puts "\n🔍 Checking configuration..."
environment = %w[sandbox staging production].include?(ARGV[0]) ? ".#{ARGV[0]}" : nil
config_file = Pathname.new(File.expand_path("config/deploy#{environment}.yml"))

unless config_file.exist?
  puts "❌ Config file not found: #{config_file}"
  exit 1
end

config = Kamal::Configuration.create_from(config_file: config_file)

hosts = config.roles.map(&:hosts).flatten + config.accessories.map(&:hosts).flatten
hosts.uniq!
user_name = config.ssh&.user || "root"

puts "📋 Environment: #{ARGV[0] || 'default'}"
puts "📄 Config file: #{config_file}"
puts "👤 SSH user: #{user_name}"
puts "🖥  Hosts: #{hosts.join(', ')}\n\n"

# ─── Helper to run a command via SSH and print output ────────────────────────

def run_step(ssh, label, script)
  puts "\n#{label}..."
  output = ssh.exec!(script)
  if output && !output.strip.empty?
    output.each_line { |line| puts "   #{line.rstrip}" }
  end
  output
end

# ─── Idempotent provisioning steps ───────────────────────────────────────────

# Install essential packages
install_essentials = <<~BASH
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq && apt-get install -y -qq build-essential curl git
BASH

# Add swap space (skip if already exists)
add_swap = <<~BASH
  if [ ! -f /swapfile ]; then
    echo "Creating <%= swap_size %> swap..."
    fallocate -l <%= swap_size %> /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
    sysctl vm.swappiness=20
    echo 'vm.swappiness=20' >> /etc/sysctl.conf
  else
    echo "Swap already exists, skipping."
  fi
BASH

# Prepare storage directory
prepare_storage = <<~BASH
  mkdir -p <%= storage_path %>
  chmod 700 <%= storage_path %>
  chown <%= storage_owner %> <%= storage_path %>
BASH

# Install Docker (skip if already installed)
install_docker = <<~BASH
  if command -v docker &> /dev/null; then
    echo "Docker already installed: $(docker --version)"
  else
    echo "Installing Docker..."
    curl -fsSL https://get.docker.com | sh
  fi
  systemctl enable docker
  systemctl start docker

  # Create kamal network if it doesn't exist (Kamal 2 expects this)
  docker network inspect kamal >/dev/null 2>&1 || docker network create kamal

  # Ensure user is in docker group
  getent group docker >/dev/null 2>&1 || groupadd docker
  usermod -aG docker "#{user_name}" 2>/dev/null || true
BASH
<%- if enable_fail2ban -%>

# Install and enable fail2ban
install_fail2ban = <<~BASH
  if command -v fail2ban-server &> /dev/null; then
    echo "fail2ban already installed."
  else
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -qq fail2ban
  fi
  systemctl enable fail2ban
  systemctl start fail2ban
BASH
<%- end -%>
<%- if enable_unattended_upgrades -%>

# Install unattended-upgrades for automatic security patches
install_unattended_upgrades = <<~BASH
  export DEBIAN_FRONTEND=noninteractive
  apt-get install -y -qq unattended-upgrades
  dpkg-reconfigure -plow unattended-upgrades 2>/dev/null || true
  systemctl enable unattended-upgrades
BASH
<%- end -%>
<%- if harden_ssh -%>

# Harden SSH configuration
harden_ssh = <<~BASH
  SSHD_CONFIG="/etc/ssh/sshd_config"

  # Disable password authentication (keys only)
  sed -i 's/^#\\?PasswordAuthentication.*/PasswordAuthentication no/' $SSHD_CONFIG
  sed -i 's/^#\\?ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' $SSHD_CONFIG
  sed -i 's/^#\\?PermitRootLogin.*/PermitRootLogin prohibit-password/' $SSHD_CONFIG

  systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true
BASH
<%- end -%>
<%- if enable_ufw -%>

# Configure firewall
# NOTE: your cloud provider's security group (hypervisor-level) is the real
# firewall. Docker bypasses UFW's iptables rules, so UFW is defense-in-depth.
configure_firewall = <<~BASH
  if ! command -v ufw &> /dev/null; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -qq ufw
  fi

  ufw logging on 2>/dev/null || true
  ufw default deny incoming 2>/dev/null || true
  ufw default allow outgoing 2>/dev/null || true
<%- ([22] + firewall_ports.map(&:to_i)).uniq.each do |port| -%>
  ufw allow <%= port %>/tcp 2>/dev/null || true
<%- end -%>
  echo "y" | ufw enable 2>/dev/null || true
  systemctl restart ufw 2>/dev/null || true

  echo ""
  echo "⚠️  Docker bypasses UFW. The real firewall is your provider's security group."
BASH
<%- end -%>

# Configure Docker daemon for production
configure_docker_daemon = <<~BASH
  DAEMON_JSON="/etc/docker/daemon.json"
  if [ ! -f "$DAEMON_JSON" ] || ! grep -q "log-driver" "$DAEMON_JSON" 2>/dev/null; then
    cat > "$DAEMON_JSON" << 'EOF'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "<%= docker_log_max_size %>",
    "max-file": "<%= docker_log_max_file %>"
  },
  "default-ulimits": {
    "nofile": {
      "Name": "nofile",
      "Hard": <%= docker_ulimit_nofile %>,
      "Soft": <%= docker_ulimit_nofile %>
    }
  }
}
EOF
    systemctl restart docker
    echo "Docker daemon configured with log rotation and ulimits."
  else
    echo "Docker daemon.json already configured."
  fi
BASH

# ─── Execute on each host ────────────────────────────────────────────────────

steps = [
  ["📦 Installing essential packages",       install_essentials],
  ["💾 Adding swap space",                    add_swap],
  ["📂 Preparing storage directory",          prepare_storage],
  ["🐳 Installing and configuring Docker",    install_docker],
<%- if enable_fail2ban -%>
  ["🛡️  Installing fail2ban",                 install_fail2ban],
<%- end -%>
<%- if enable_unattended_upgrades -%>
  ["🔄 Installing unattended-upgrades",       install_unattended_upgrades],
<%- end -%>
<%- if harden_ssh -%>
  ["🔐 Hardening SSH",                        harden_ssh],
<%- end -%>
<%- if enable_ufw -%>
  ["🧱 Configuring firewall",                 configure_firewall],
<%- end -%>
  ["⚙️  Configuring Docker daemon",            configure_docker_daemon],
]

success_count = 0
error_hosts = []

hosts.each do |host|
  puts "═" * 60
  puts "🖥  Provisioning server '#{host}' as '#{user_name}'..."
  puts "═" * 60

  begin
    Net::SSH.start(host, user_name) do |ssh|
      steps.each do |label, script|
        run_step(ssh, label, script)
      end
    end
    success_count += 1
    puts "\n✅ Server '#{host}' provisioned successfully.\n\n"
  rescue Net::SSH::AuthenticationFailed => e
    error_hosts << { host: host, error: "Authentication failed: #{e.message}" }
    puts "\n❌ Authentication failed for '#{host}': #{e.message}\n\n"
  rescue Errno::ECONNREFUSED, Errno::ETIMEDOUT, SocketError => e
    error_hosts << { host: host, error: "Connection failed: #{e.message}" }
    puts "\n❌ Connection failed for '#{host}': #{e.message}\n\n"
  end
end

# ─── Summary ──────────────────────────────────────────────────────────────────

puts "\n" + "═" * 60
puts "📊 Provisioning Summary"
puts "═" * 60
puts "✅ Successful: #{success_count}/#{hosts.size}"

if error_hosts.any?
  puts "❌ Failed:"
  error_hosts.each { |h| puts "   #{h[:host]}: #{h[:error]}" }
end

puts "\n📋 Next steps:"
puts "   1. Verify your firewall/security group allows TCP <%= ([22] + firewall_ports.map(&:to_i)).uniq.join(', ') %> inbound only"
puts "   2. Run: kamal setup -d #{ARGV[0] || 'production'}"
puts "   3. Run: kamal app exec --primary 'bin/rails db:migrate' -d #{ARGV[0] || 'production'}"
puts "\nSSH into your servers:"
hosts.each { |h| puts "   ssh #{user_name}@#{h}" }
